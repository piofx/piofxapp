    "html": "<div id=\"request_free_test\" class=\"modal fade\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"exampleModalTopCoverTitle\"\r\n    aria-hidden=\"true\">\r\n    <div class=\"modal-dialog modal-dialog-centered\" role=\"document\">\r\n        <div class=\"modal-content\">\r\n            <div class=\"modal-close\">\r\n                <button type=\"button\" class=\"btn btn-icon btn-sm btn-ghost-success\" data-dismiss=\"modal\"\r\n                    aria-label=\"Close\">\r\n                    <svg width=\"16\" height=\"16\" viewBox=\"0 0 18 18\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\r\n                        <path fill=\"#000\"\r\n                            d=\"M11.5,9.5l5-5c0.2-0.2,0.2-0.6-0.1-0.9l-1-1c-0.3-0.3-0.7-0.3-0.9-0.1l-5,5l-5-5C4.3,2.3,3.9,2.4,3.6,2.6l-1,1 C2.4,3.9,2.3,4.3,2.5,4.5l5,5l-5,5c-0.2,0.2-0.2,0.6,0.1,0.9l1,1c0.3,0.3,0.7,0.3,0.9,0.1l5-5l5,5c0.2,0.2,0.6,0.2,0.9-0.1l1-1 c0.3-0.3,0.3-0.7,0.1-0.9L11.5,9.5z\" \/>\r\n                    <\/svg>\r\n                <\/button>\r\n            <\/div>\r\n            <form class=\"js-validate\" action=\"\/admin\/contact\" data-otp=\"1\">\r\n                <div class=\"card-header border-0 bg-light text-center py-4 px-4\">\r\n                    <h2 class=\"h2 mb-0\" style= \"color: #059862\">Request for a Free Test<\/h2>\r\n                <\/div>\r\n\r\n                <div class=\"card-body p-4\">\r\n                <div class=\"alert alert-soft-primary alert_block\" style=\"display:none\"><div class=\"alert_message\"><\/div><\/div>\r\n                <div class=\"otp_block\" style=\"display:none\">\r\n                    <h5 >OTP Verification<\/h5>\r\n                    <input type=\"text\" class=\"form-control otp_input\"  placeholder=\"Enter the 4 digit OTP sent to you phone\" data-otp=\"\">\r\n                    <small id=\"emailHelp\" class=\"form-text text-muted\">Kindly wait for 5secs before retrying.<\/small>\r\n                    <div class=\"alert alert-soft-success otp_message mt-2\" role=\"alert\" style=\"display:none\">\r\n                                Invalid OTP. Kindly refresh the page and retry.\r\n                    <\/div>\r\n                    <button type=\"button\" class=\"btn btn-primary otp_button mt-3\">Verify<\/button>\r\n                    <div class=\"spinner-border ml-2 mt-3\" role=\"status\" style=\"display:none\">\r\n                    <span class=\"sr-only\">Loading...<\/span>\r\n                    <\/div>\r\n                <\/div>\r\n                <div class=\"contact_block\">\r\n                    <div class=\"alert alert-soft-success\" role=\"alert\">\r\n                    Please include the country code with the number. (Eg: <kbd>+91<\/kbd> for India; <kbd>+65<\/kbd> For Singapore).\r\n                    <\/div>\r\n                    <div class=\"row\">\r\n                    <div class=\"col-sm-6\">\r\n                        <!-- Form Group -->\r\n                        <div class=\"js-form-message form-group\">\r\n                        <label for=\"firstNameExample1\" class=\"input-label\">Name<\/label>\r\n                        <input type=\"text\" class=\"form-control\" name=\"name\" id=\"firstNameExample1\" placeholder=\"Full name\" aria-label=\"Nataly\" required\r\n                                data-msg=\"Please enter your name\">\r\n                        <\/div>\r\n                        <!-- End Form Group -->\r\n                    <\/div>\r\n\r\n                    <div class=\"col-sm-6\">\r\n                        <!-- Form Group -->\r\n                        <div class=\"js-form-message form-group\">\r\n                        <label for=\"lastNameExample1\" class=\"input-label\">Phone<\/label>\r\n                        <input type=\"text\" class=\"form-control\" name=\"phone\" id=\"lastNameExample1\" placeholder=\"Phone number\" aria-label=\"Gaga\" required\r\n                                data-msg=\"Please enter phone number\">\r\n                        <\/div>\r\n                        <!-- End Form Group -->\r\n                    <\/div>\r\n\r\n                    <div class=\"col-sm-12\">\r\n                        <!-- Form Group -->\r\n                        <div class=\"js-form-message form-group\">\r\n                        <label for=\"emailAddressExample1\" class=\"input-label\">Email address<\/label>\r\n                        <input type=\"email\" class=\"form-control\" name=\"email\" id=\"emailAddressExample1\" placeholder=\"your email id\"  required\r\n                                data-msg=\"Please enter a valid email address\">\r\n                                <input type=\"hidden\" class=\"form-control\" name=\"message\" value=\"Request for a free ielts test\" >\r\n                                <input type=\"hidden\" class=\"form-control\" name=\"category\" value=\"ieltstest\" >\r\n                        <\/div>\r\n                        <!-- End Form Group -->\r\n\r\n                        <!-- Form Group -->\r\n                        <div class=\"js-form-message form-group\">\r\n                        <label for=\"message\" class=\"input-label\">Which Test(s) do you wish to take?<\/label>\r\n                        <div class=\"input-group\">\r\n                            <textarea class=\"form-control\" rows=\"4\" name=\"message\" id=\"message\" placeholder=\"Clearly mention the name of test(s). Ex: IELTS General\" aria-label=\"Hi there, I would like to ...\" required\r\n                                    data-msg=\"Please enter a reason.\"><\/textarea>\r\n                        <\/div>\r\n                        <\/div>\r\n                        <!-- End Form Group -->\r\n                    <\/div>\r\n\r\n                    \r\n                    <\/div>\r\n                    \r\n                        <button type=\"button\" class=\"btn btn-block  transition-3d-hover contact_button\" style=\"background-color: #059862; color: #fff;\">Submit<\/button>     \r\n                        