 type=\"button\" class=\"btn btn-primary otp_button mt-3\">Verify<\/button>\r\n                <div class=\"spinner-border ml-2 mt-3\" role=\"status\" style=\"display:none\">\r\n                    <span class=\"sr-only\">Loading...<\/span>\r\n                <\/div>\r\n                <\/div>\r\n                <div class=\"contact_block\">\r\n            <div class=\"alert alert-soft-success mb-0\" role=\"alert\">\r\n                    Do enter the country code with your phone number.<br> Ex: <kbd>+91<\/kbd> for India, <kbd>+1<\/kbd> for the USA.\r\n                    <\/div>\r\n\r\n                 <h4 class=\"mt-3 mb-2\">Talk to us!<\/h4>\r\n                    <div class=\"row\">\r\n                    <div class=\"col-sm-6\">\r\n                        <!-- Form Group -->\r\n                        <div class=\"js-form-message form-group\">\r\n                        <label for=\"firstNameExample1\" class=\"input-label\">Name<\/label>\r\n                        <input type=\"text\" class=\"form-control\" name=\"name\" id=\"firstNameExample1\" placeholder=\"Full Name\" aria-label=\"Nataly\" required\r\n                                data-msg=\"Please enter your name\">\r\n                        <\/div>\r\n                        <!-- End Form Group -->\r\n                    <\/div>\r\n\r\n                    <div class=\"col-sm-6\">\r\n                        <!-- Form Group -->\r\n                        <div class=\"js-form-message form-group\">\r\n                        <label for=\"lastNameExample1\" class=\"input-label\">Phone<\/label>\r\n                        <input type=\"text\" class=\"form-control\" name=\"phone\" id=\"lastNameExample1\" placeholder=\"Phone Number\" aria-label=\"Gaga\" required\r\n                                data-msg=\"Please enter phone number\">\r\n                        <\/div>\r\n                        <!-- End Form Group -->\r\n                    <\/div>\r\n\r\n                    <div class=\"col-sm-12\">\r\n                        <!-- Form Group -->\r\n                        <div class=\"js-form-message form-group\">\r\n                        <label for=\"emailAddressExample1\" class=\"input-label\">Email address<\/label>\r\n                        <input type=\"email\" class=\"form-control\" name=\"email\" id=\"emailAddressExample1\" placeholder=\"E-mail ID\" aria-label=\"alex@pixeel.com\" required\r\n                                data-msg=\"Please enter a valid email address\">\r\n                        <\/div>\r\n                        <!-- End Form Group -->\r\n                    <\/div>\r\n\r\n                    <div class=\"col-sm-12\">\r\n                        <!-- Form Group -->\r\n                        <div class=\"js-form-message form-group\">\r\n                        <label for=\"message\" class=\"input-label\">Message<\/label>\r\n                        <div class=\"input-group\">\r\n                            <textarea class=\"form-control\" rows=\"4\" name=\"message\" id=\"message\" placeholder=\"Type your message here...\" aria-label=\"Hi there, I would like to ...\" required\r\n                                    data-msg=\"Please enter a reason.\"><\/textarea>\r\n                        <\/div>\r\n                        <\/div>\r\n                        <!-- End Form Group -->\r\n                    <\/div>\r\n                    <\/div>\r\n\r\n                    <input type=\"hidden\" class=\"form-control mt-2\" placeholder=\"Name\" name=\"category\" value=\"contact\">\r\n                    <input type=\"hidden\" class=\"form-control mt-2\" placeholder=\"Name\" name=\"settings_request\" value=\"General Enquiry\">\r\n                    <button type=\"button\" class=\"btn btn-success btn-sm mt-3 contact_button\">Submit<\/button>\r\n                    <\/div>\r\n                \r\n            <\/div>\r\n        <\/div>\r\n        <\/form>\r\n    <\/div>\r\n<\/div>",
