    "html": "<div id=\"demo_class\" class=\"modal fade\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"exampleModalTopCoverTitle\"\r\n    aria-hidden=\"true\">\r\n    <div class=\"modal-dialog modal-dialog-centered\" role=\"document\">\r\n        <div class=\"modal-content\">\r\n            <div class=\"modal-close\">\r\n                <button type=\"button\" class=\"btn btn-icon btn-sm btn-ghost-danger\" data-dismiss=\"modal\"\r\n                    aria-label=\"Close\">\r\n                    <svg width=\"16\" height=\"16\" viewBox=\"0 0 18 18\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\r\n                        <path fill=\"#000\"\r\n                            d=\"M11.5,9.5l5-5c0.2-0.2,0.2-0.6-0.1-0.9l-1-1c-0.3-0.3-0.7-0.3-0.9-0.1l-5,5l-5-5C4.3,2.3,3.9,2.4,3.6,2.6l-1,1 C2.4,3.9,2.3,4.3,2.5,4.5l5,5l-5,5c-0.2,0.2-0.2,0.6,0.1,0.9l1,1c0.3,0.3,0.7,0.3,0.9,0.1l5-5l5,5c0.2,0.2,0.6,0.2,0.9-0.1l1-1 c0.3-0.3,0.3-0.7,0.1-0.9L11.5,9.5z\" \/>\r\n                    <\/svg>\r\n                <\/button>\r\n            <\/div>\r\n\r\n            <div class=\"modal-body p-0 text-center \">\r\n\r\n                <form class=\"js-validate card p-4 shadow-lg mb-0\" action=\"\/admin\/contact\" data-otp=\"1\">\r\n            <div class=\"alert alert-soft-primary alert_block m-3\" style=\"display:none\"><div class=\"alert_message\"><\/div><\/div>\r\n                <div class=\"otp_block m-3\" style=\"display:none\">\r\n                <h5 >OTP Verification<\/h5>\r\n                <input type=\"text\" class=\"form-control otp_input\"  placeholder=\"Enter the 4 digit OTP sent to you phone\" data-otp=\"\">\r\n                <small id=\"emailHelp\" class=\"form-text text-muted\">Kindly wait for 5secs before retrying.<\/small>\r\n                <div class=\"alert alert-soft-success otp_message mt-2\" role=\"alert\" style=\"display:none\">\r\n                                Invalid OTP. Kindly refresh the page and retry.\r\n                <\/div>\r\n                <button type=\"button\" class=\"btn btn-primary otp_button mt-3\">Verify<\/button>\r\n                <div class=\"spinner-border ml-2 mt-3\" role=\"status\" style=\"display:none\">\r\n                    <span class=\"sr-only\">Loading...<\/span>\r\n                <\/div>\r\n                <\/div>\r\n                <div class=\"contact_block\">\r\n            <div class=\"alert alert-soft-primary mb-0\" role=\"alert\">\r\n                    Do enter the country code of your phone number.<br> Ex: <kbd>+91<\/kbd> for India, <kbd>+1<\/kbd> for the USA.\r\n                    <\/div><br>\r\n                    <h3 Style=\"color:#1e3b6f\">Where would you want to attend a demo<\/h3>\r\n                    <div class=\"my-3 bg-soft-primary py-3 rounded-lg\">\r\n                        <div class=\"form-check form-check-inline\">\r\n                            <input class=\"form-check-input\" type=\"radio\" name=\"settings_location\" id=\"Ameerpet\" value=\"ameerpet\">\r\n                            <label class=\"form-check-label\" for=\"Ameerpet\">Ameerpet<\/label>\r\n                        <\/div>\r\n                        <div class=\"form-check form-check-inline\">\r\n                            <input class=\"form-check-input\" type=\"radio\" name=\"settings_location\" id=\"Madhapur\" value=\"madhapur\">\r\n                            <label class=\"form-check-label\" for=\"Madhapur\">Madhapur<\/label>\r\n                        <\/div>\r\n                        <div class=\"form-check form-check-inline\">\r\n                            <input class=\"form-check-input\" type=\"radio\" name=\"settings_location\" id=\"Online\" value=\"online\">\r\n                            <label class=\"form-check-label\" for=\"Online\">Online<\/label>\r\n                        <\/div>\r\n                    <\/div>\r\n                    <h3 Style=\"color:#1e3b6f\">Which session would you like to try?<\/h3>\r\n                        <div class=\"my-3 py-3 bg-soft-primary rounded-lg\">\r\n                        <div class=\"form-check form-check-inline\">\r\n                            <input class=\"form-check-input\" type=\"checkbox\" value=\"gre\" id=\"gre\" name=\"settings_course[]\">\r\n                            <label class=\"form-check-label\" for=\"gre\">\r\n                                GRE\r\n                            <\/label>\r\n                        <\/div>\r\n                        <div class=\"form-check form-check-inline\">\r\n                            <input class=\"form-check-input\" type=\"checkbox\" value=\"ielts\" id=\"ielts\" name=\"settings_course[]\">\r\n                            <label class=\"form-check-label\" for=\"ielts\">\r\n                                IELTS\r\n                            <\/label>\r\n                        <\/div>\r\n                        <div class=\"form-check form-check-inline\">\r\n                            <input class=\"form-check-input\" type=\"checkbox\" value=\"toefl\" id=\"toefl\" name=\"settings_course[]\">\r\n                            <label class=\"form-check-label\" for=\"toefl\">\r\n                                TOEFL\r\n                            <\/label>\r\n                        <\/div>\r\n                        <div class=\"form-check form-check-inline\">\r\n                            <input class=\"form-check-input\" type=\"checkbox\" value=\"pte\" id=\"pte\" name=\"settings_course[]\">\r\n                            <label class=\"form-check-label\" for=\"pte\">\r\n                                PTE\r\n                            <\/label>\r\n                        <\/div>\r\n                        <div class=\"form-check form-check-inline\">\r\n                            <input class=\"form-check-input\" type=\"checkbox\" value=\"oet\" id=\"oet\" name=\"settings_course[]\">\r\n                            <label class=\"form-check-label\" for=\"oet\">\r\n                                OET\r\n                            <\/label>\r\n                        <\/div>\r\n                        <div class=\"form-check form-check-inline\">\r\n                            <input class=\"form-check-input\" type=\"checkbox\" value=\"sat\" id=\"sat\" name=\"settings_course[]\">\r\n                            <label class=\"form-check-label\" for=\"sat\">\r\n                                SAT\r\n                            <\/label>\r\n                        <\/div>\r\n                        <div class=\"form-check form-check-inline\">\r\n                            <input class=\"form-check-input\" type=\"checkbox\" value=\"others\" id=\"others\" name=\"settings_course[]\">\r\n                            <label class=\"form-check-label\" for=\"others\">\r\n                                Others\r\n                            <\/label>\r\n                        <\/div>\r\n                    <\/div>\r\n                    <input type=\"hidden\" class=\"form-control mt-2\" placeholder=\"Name\" name=\"category\" value=\"democlass\">\r\n                    <input type=\"hidden\" class=\"form-control mt-2\" placeholder=\"Name\" name=\"settings_request\" value=\"Demo Class\">\r\n                    <input type=\"text\" class=\"form-control mt-2\" placeholder=\"Name\" name=\"name\">\r\n                    <input type=\"email\" class=\"form-control mt-2\" placeholder=\"Email\" name=\"email\">\r\n                    <input type=\"text\" class=\"form-control mt-2\" placeholder=\"Phone Number\" name=\"phone\">\r\n                    <button type=\"button\" class=\"btn btn-block transition-3d-hover contact_button mt-3\" Style=\"background-color:#1e3b6f; color: #ffffff\">Submit<\/button>\r\n                    <\/div>\r\n                \r\n            <\/div>\r\n        <\/div>\r\n        <\/form>\r\n    <\/div>\r\n<\/div>",
